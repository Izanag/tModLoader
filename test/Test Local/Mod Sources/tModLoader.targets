<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="../../../src/WorkspaceInfo.targets" />
  <PropertyGroup>
    <_InstalledTmlTargetsPath>$(tModLoaderSteamPath)\tMLMod.targets</_InstalledTmlTargetsPath>
    <_RepoTmlTargetsPath>../../../src/tModLoader/Terraria/release_extras/tMLMod.targets</_RepoTmlTargetsPath>
    <_RepoTmlOutputPath>../../../src/tModLoader/Terraria/bin/$(Configuration)/net10.0/</_RepoTmlOutputPath>
    <tModLoaderSteamPath Condition="!Exists('$(_InstalledTmlTargetsPath)')">$(_RepoTmlOutputPath)</tModLoaderSteamPath>
    <tMLSteamPath Condition="'$(tMLSteamPath)' == ''">$([MSBuild]::EnsureTrailingSlash('$(tModLoaderSteamPath)'))</tMLSteamPath>
  </PropertyGroup>
  <Import Project="$(tModLoaderSteamPath)/tMLMod.targets" Condition="Exists('$(tModLoaderSteamPath)/tMLMod.targets')" />
  <Import Project="$(_RepoTmlTargetsPath)" Condition="!Exists('$(tModLoaderSteamPath)/tMLMod.targets') AND Exists('$(_RepoTmlTargetsPath)')" />
</Project>
